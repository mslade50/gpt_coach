{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "become-fast-sync",
  "main": "worker.mjs",
  "account_id": "ba4875f01f2bc46dd48e1e26d2ec9080",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {"enabled": false},
  "limits": {"cpu_ms": 10},
  "vars": {
    "SITE_ORIGIN": "https://mslade50.github.io",
    "SITE_PATH": "/gpt_coach/",
    "SPREADSHEET_ID": "1kcFtPe_-5ng3wdKaEA720P7e9vbjXhvJDBf8wMVwK8Y"
  },
  "d1_databases": [{"binding": "DB", "database_name": "become-fast-connections", "database_id": "29084289-684d-40b0-862e-9227c87fab71"}],
  "triggers": {"crons": ["17 * * * *"]}
}
